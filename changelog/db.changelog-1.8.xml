<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Alembic revision: d4e8f1a2b3c5 -->

    <changeSet id="08-levy-charges" author="nrf">
        <createTable tableName="levy_charges" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="edp_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="edp_name" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="edp_start_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="charge_valid_from" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="charge_valid_to" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="base_charge_per_unit" type="numeric(12,4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="uq_levy_charges_edp_from"
                             tableName="levy_charges" schemaName="public"
                             columnNames="edp_id, charge_valid_from"/>
        <createIndex indexName="ix_public_levy_charges_edp_id"
                     tableName="levy_charges" schemaName="public">
            <column name="edp_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="levy_charges" schemaName="public"/>
        </rollback>
    </changeSet>

    <changeSet id="08-levy-calculations" author="nrf">
        <createTable tableName="levy_calculations" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quote_reference" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="edp_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="edp_name" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="edp_start_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="calculator_version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="base_charge_per_unit" type="numeric(12,4)">
                <constraints nullable="false"/>
            </column>
            <column name="rounded_charge_per_unit" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="units" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="provisional_amount" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="inflation_adjusted_amount" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="ix_public_levy_calculations_quote_reference"
                     tableName="levy_calculations" schemaName="public">
            <column name="quote_reference"/>
        </createIndex>
        <rollback>
            <dropTable tableName="levy_calculations" schemaName="public"/>
        </rollback>
    </changeSet>

    <changeSet id="08-levy-inflation-index" author="nrf">
        <createTable tableName="levy_inflation_index" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="charging_year" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="cil_index" type="numeric(10,4)">
                <constraints nullable="false"/>
            </column>
            <column name="index_factor" type="numeric(10,4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="uq_levy_inflation_index_year"
                             tableName="levy_inflation_index" schemaName="public"
                             columnNames="charging_year"/>
        <createIndex indexName="ix_public_levy_inflation_index_charging_year"
                     tableName="levy_inflation_index" schemaName="public">
            <column name="charging_year"/>
        </createIndex>
        <rollback>
            <dropTable tableName="levy_inflation_index" schemaName="public"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
