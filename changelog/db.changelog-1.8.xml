<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Alembic revision: d5a1c7b3e2f8 -->

    <!--
      Repairs databases that were stamped onto the squashed baseline instead of
      running it: edp_boundary_layer (from the squashed 1bf027d04bb3) is missing,
      and the legacy shared spatial_layer superseded by db.changelog-1.1.xml is
      still present. Every changeSet is guarded by a precondition so a correctly
      migrated database marks them ran and nothing is touched.
    -->

    <changeSet id="08-repair-edp-boundary-layer" author="nrf">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="edp_boundary_layer" schemaName="public"/>
            </not>
        </preConditions>
        <createTable tableName="edp_boundary_layer" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="geometry" type="geometry(GEOMETRY,27700)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar"/>
            <column name="attributes" type="jsonb"/>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback/>
    </changeSet>

    <changeSet id="08-repair-edp-boundary-layer-name-index" author="nrf">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="ix_public_edp_boundary_layer_name"
                             schemaName="public"/>
            </not>
        </preConditions>
        <createIndex indexName="ix_public_edp_boundary_layer_name"
                     tableName="edp_boundary_layer" schemaName="public">
            <column name="name"/>
        </createIndex>
        <rollback/>
    </changeSet>

    <changeSet id="08-repair-edp-boundary-layer-version-index" author="nrf">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="ix_public_edp_boundary_layer_version"
                             schemaName="public"/>
            </not>
        </preConditions>
        <createIndex indexName="ix_public_edp_boundary_layer_version"
                     tableName="edp_boundary_layer" schemaName="public">
            <column name="version"/>
        </createIndex>
        <rollback/>
    </changeSet>

    <changeSet id="08-repair-edp-boundary-layer-geometry-index" author="nrf">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="ix_public_edp_boundary_layer_geometry"
                             schemaName="public"/>
            </not>
        </preConditions>
        <sql>
            CREATE INDEX ix_public_edp_boundary_layer_geometry
            ON public.edp_boundary_layer USING GIST (geometry)
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="08-drop-legacy-spatial-layer" author="nrf">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="spatial_layer" schemaName="public"/>
        </preConditions>
        <dropTable tableName="spatial_layer" schemaName="public" cascadeConstraints="true"/>
        <rollback/>
    </changeSet>

</databaseChangeLog>
