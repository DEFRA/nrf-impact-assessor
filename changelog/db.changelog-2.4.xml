<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Alembic revision: c9e1a3b5d7f2 -->

    <!-- Nullable: rows that already exist, such as the seeded first price, have
         neither. The API requires both for every price it adds. -->
    <changeSet id="14-base-prices-requestor-and-jira-ticket" author="nrf">
        <addColumn tableName="base_prices" schemaName="public">
            <column name="requestor" type="varchar(255)"/>
            <column name="jira_ticket" type="varchar(20)"/>
        </addColumn>
        <sql>ALTER TABLE public.base_prices
            ADD CONSTRAINT ck_base_prices_requestor_not_blank
            CHECK (requestor ~ '\S')</sql>
        <sql>ALTER TABLE public.base_prices
            ADD CONSTRAINT ck_base_prices_jira_ticket_format
            CHECK (jira_ticket ~ '^NRF2-[0-9]+$')</sql>
        <rollback>
            <dropColumn tableName="base_prices" schemaName="public" columnName="jira_ticket"/>
            <dropColumn tableName="base_prices" schemaName="public" columnName="requestor"/>
        </rollback>
    </changeSet>

    <!-- Alembic revision: 2ddd520a2291 -->

    <!-- Columns are added nullable and backfilled before the NOT NULL
         constraints, mirroring Alembic revision 2ddd520a2291: rows that
         already exist (a fixture load or an earlier insert) have neither,
         so adding them NOT NULL outright fails with "column ... contains
         null values". -->
    <changeSet id="15-inflation-index-provenance" author="nrf">
        <!-- The checksum of the first version, from PR #205. Environments that
             applied it before the backfill was added in PR #209 keep that
             checksum. Both versions leave the same schema. -->
        <validCheckSum>9:d877396fe2ff4becd4512fe74bab7b8d</validCheckSum>
        <addColumn tableName="levy_inflation_index" schemaName="public">
            <column name="comment" type="varchar(500)"/>
            <column name="staff_id" type="varchar(36)"/>
            <column name="staff_full_name" type="varchar(255)"/>
            <column name="staff_email" type="varchar(254)"/>
        </addColumn>
        <sql>UPDATE public.levy_inflation_index
            SET comment = 'Seeded with the published RICS CIL Index values',
                staff_id = 'system',
                staff_full_name = 'system',
                staff_email = 'system@nrf.invalid'</sql>
        <addNotNullConstraint tableName="levy_inflation_index" schemaName="public"
                              columnName="comment" columnDataType="varchar(500)"/>
        <addNotNullConstraint tableName="levy_inflation_index" schemaName="public"
                              columnName="staff_id" columnDataType="varchar(36)"/>
        <addNotNullConstraint tableName="levy_inflation_index" schemaName="public"
                              columnName="staff_full_name" columnDataType="varchar(255)"/>
        <addNotNullConstraint tableName="levy_inflation_index" schemaName="public"
                              columnName="staff_email" columnDataType="varchar(254)"/>
        <sql>ALTER TABLE public.levy_inflation_index
            ADD CONSTRAINT ck_levy_inflation_index_cil_index
            CHECK (cil_index &gt; 0 AND cil_index &lt;&gt; 'NaN')</sql>
        <sql>ALTER TABLE public.levy_inflation_index
            ADD CONSTRAINT ck_levy_inflation_index_comment_not_blank
            CHECK (comment ~ '\S')</sql>
        <rollback>
            <sql>ALTER TABLE public.levy_inflation_index
                DROP CONSTRAINT ck_levy_inflation_index_comment_not_blank</sql>
            <sql>ALTER TABLE public.levy_inflation_index
                DROP CONSTRAINT ck_levy_inflation_index_cil_index</sql>
            <dropColumn tableName="levy_inflation_index" schemaName="public"
                        columnName="comment"/>
            <dropColumn tableName="levy_inflation_index" schemaName="public"
                        columnName="staff_id"/>
            <dropColumn tableName="levy_inflation_index" schemaName="public"
                        columnName="staff_full_name"/>
            <dropColumn tableName="levy_inflation_index" schemaName="public"
                        columnName="staff_email"/>
        </rollback>
    </changeSet>

    <!-- The 2026 base row and the 2027 charging-schedule row (both factor
         1.0000) are seeded so a quote can always be priced from 1 Jan 2027,
         when every quote crosses charging years. ON CONFLICT DO NOTHING keeps
         any rows a local fixture load already inserted. -->
    <changeSet id="15-inflation-index-seeds" author="nrf">
        <sql>INSERT INTO public.levy_inflation_index
            (id, charging_year, cil_index, index_factor, comment,
             staff_id, staff_full_name, staff_email)
            VALUES (gen_random_uuid(), 2026, 400.0000, 1.0000,
                'Seeded with the published RICS CIL Index values',
                'system', 'system', 'system@nrf.invalid')
            ON CONFLICT (charging_year) DO NOTHING</sql>
        <sql>INSERT INTO public.levy_inflation_index
            (id, charging_year, cil_index, index_factor, comment,
             staff_id, staff_full_name, staff_email)
            VALUES (gen_random_uuid(), 2027, 400.0000, 1.0000,
                'Factor is 1.0000 throughout 2027, as set by the charging schedule',
                'system', 'system', 'system@nrf.invalid')
            ON CONFLICT (charging_year) DO NOTHING</sql>
        <rollback>
            <sql>DELETE FROM public.levy_inflation_index
                WHERE staff_id = 'system'
                AND comment IN ('Seeded with the published RICS CIL Index values',
                                'Factor is 1.0000 throughout 2027, as set by the charging schedule')
                AND charging_year IN (2026, 2027)</sql>
        </rollback>
    </changeSet>

    <!-- Alembic revision: e05a352f9ebe -->

    <!-- Nullable: rows seeded by the provenance changeset have neither. The
         API requires both for every index it adds. -->
    <changeSet id="16-inflation-index-requestor-and-jira-ticket" author="nrf">
        <addColumn tableName="levy_inflation_index" schemaName="public">
            <column name="requestor" type="varchar(255)"/>
            <column name="jira_ticket" type="varchar(20)"/>
        </addColumn>
        <sql>ALTER TABLE public.levy_inflation_index
            ADD CONSTRAINT ck_levy_inflation_index_requestor_not_blank
            CHECK (requestor ~ '\S')</sql>
        <sql>ALTER TABLE public.levy_inflation_index
            ADD CONSTRAINT ck_levy_inflation_index_jira_ticket_format
            CHECK (jira_ticket ~ '^NRF2-[0-9]+$')</sql>
        <rollback>
            <dropColumn tableName="levy_inflation_index" schemaName="public" columnName="jira_ticket"/>
            <dropColumn tableName="levy_inflation_index" schemaName="public" columnName="requestor"/>
        </rollback>
    </changeSet>

    <!-- Alembic revision: a3f6c8d2e4b7 -->

    <!-- One row per inflation index addition, written in the same
         transaction as the add. Amendments and deletions are not recorded.
         The table starts empty: the seeded rows predate admin additions, so
         there is nothing to backfill. inflation_index_id has no foreign key
         on purpose: a deleted index must keep its history. -->
    <changeSet id="17-inflation-index-history" author="nrf">
        <createTable tableName="levy_inflation_index_history" schemaName="public">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="inflation_index_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="charging_year" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="cil_index" type="numeric(10,4)">
                <constraints nullable="false"/>
            </column>
            <column name="index_factor" type="numeric(10,4)">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="staff_id" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="staff_full_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="staff_email" type="varchar(254)">
                <constraints nullable="false"/>
            </column>
            <column name="requestor" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="jira_ticket" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE public.levy_inflation_index_history
            ADD CONSTRAINT ck_levy_inflation_index_history_comment_not_blank
            CHECK (comment ~ '\S')</sql>
        <createIndex indexName="ix_public_levy_inflation_index_history_inflation_index_id"
                     tableName="levy_inflation_index_history" schemaName="public">
            <column name="inflation_index_id"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="ix_public_levy_inflation_index_history_inflation_index_id"
                       tableName="levy_inflation_index_history" schemaName="public"/>
            <dropTable tableName="levy_inflation_index_history" schemaName="public"/>
        </rollback>
    </changeSet>

    <!-- Alembic revision: 9a4d7c2b1e30 -->

    <!-- The levy calculation history now lives in nrf-backend. Rows are
         discarded: there is no production data yet. The rollback recreates the
         table empty. -->
    <changeSet id="17-drop-audit-levy-calculations" author="nrf">
        <dropTable tableName="audit_levy_calculations" schemaName="public"/>
        <rollback>
            <createTable tableName="audit_levy_calculations" schemaName="public">
                <column name="id" type="uuid">
                    <constraints primaryKey="true" nullable="false"/>
                </column>
                <column name="quote_reference" type="varchar">
                    <constraints nullable="false"/>
                </column>
                <column name="edp_id" type="integer">
                    <constraints nullable="false"/>
                </column>
                <column name="edp_name" type="varchar">
                    <constraints nullable="false"/>
                </column>
                <column name="edp_start_date" type="date">
                    <constraints nullable="false"/>
                </column>
                <column name="calculator_version" type="integer">
                    <constraints nullable="false"/>
                </column>
                <column name="base_charge_per_unit" type="numeric(12,4)">
                    <constraints nullable="false"/>
                </column>
                <column name="units" type="integer">
                    <constraints nullable="false"/>
                </column>
                <column name="calculation_date" type="date">
                    <constraints nullable="false"/>
                </column>
                <column name="provisional_amount" type="numeric(12,2)">
                    <constraints nullable="false"/>
                </column>
                <column name="inflation_adjusted_amount" type="numeric(12,2)">
                    <constraints nullable="false"/>
                </column>
                <column name="levy_charge_id" type="integer"/>
                <column name="edp_start_year_index_id" type="uuid"/>
                <column name="edp_start_year_index_factor" type="numeric(10,4)"/>
                <column name="calculation_year_index_id" type="uuid"/>
                <column name="calculation_year_index_factor" type="numeric(10,4)"/>
                <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                    <constraints nullable="false"/>
                </column>
                <column name="sent_at" type="timestamptz"/>
            </createTable>
            <createIndex indexName="ix_public_audit_levy_calculations_quote_reference"
                         tableName="audit_levy_calculations" schemaName="public">
                <column name="quote_reference"/>
            </createIndex>
            <createIndex indexName="ix_public_audit_levy_calculations_levy_charge_id"
                         tableName="audit_levy_calculations" schemaName="public">
                <column name="levy_charge_id"/>
            </createIndex>
            <addForeignKeyConstraint constraintName="fk_audit_levy_calculations_edp_start_year_index"
                                     baseTableName="audit_levy_calculations"
                                     baseTableSchemaName="public"
                                     baseColumnNames="edp_start_year_index_id"
                                     referencedTableName="levy_inflation_index"
                                     referencedTableSchemaName="public"
                                     referencedColumnNames="id"
                                     onDelete="RESTRICT"/>
            <addForeignKeyConstraint constraintName="fk_audit_levy_calculations_calculation_year_index"
                                     baseTableName="audit_levy_calculations"
                                     baseTableSchemaName="public"
                                     baseColumnNames="calculation_year_index_id"
                                     referencedTableName="levy_inflation_index"
                                     referencedTableSchemaName="public"
                                     referencedColumnNames="id"
                                     onDelete="RESTRICT"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
