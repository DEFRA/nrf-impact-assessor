# Root environment configuration
# ===============================
# Copy to .env and customise for local development:
#   cp .env.example .env
#
# All pydantic settings classes (DatabaseSettings, AppConfig, etc.)
# read this file automatically. Real environment variables override
# values set here; scripts/.env.local overrides for script-specific
# settings (file paths, etc.).

# --- Database (DB_ prefix) ---
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=nrf_impact
DB_USER=postgres
DB_LOCAL_PASSWORD=
DB_IAM_AUTHENTICATION=false

# --- App ---
# PYTHON_ENV=development
# HOST=127.0.0.1
# PORT=8086

# --- API server (API_ prefix) ---
# API_HOST=0.0.0.0
# API_PORT=8085
# API_TESTING_ENABLED=true

# --- Backend callback (BACKEND_ prefix) ---
# BACKEND_BASE_URL=http://localhost:3001
# BACKEND_API_KEY=

# --- MongoDB ---
# Optional locally. The app never reads or writes mongo; it is a CDP platform
# dependency that is only pinged at startup. Leave MONGO_URI unset (or blank)
# to boot without a mongo container; set it to connect and ping as in CDP.
# MONGO_URI=mongodb://localhost:27018/
# MONGO_DATABASE=nrf-impact-assessor

# --- AWS / LocalStack (AWS_ prefix) ---
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=eu-west-2
# AWS_SQS_QUEUE_URL=

# --- Auth ---
# IMPACT_ASSESSOR_API_KEY=

# --- Aerial Image Service ---
AERIAL_PROXY_BASE_URL=
